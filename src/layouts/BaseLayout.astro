---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Corthyn's Blog" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/png" href="/images/0010.png" />
    <link rel="stylesheet" href="https://unpkg.com/@waline/client@v3/dist/waline.css" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="d5de339a-b424-4354-9b3d-b0fe1a85ec11"></script>
  </head>
  <body>
    <nav class="navbar">
      <div class="navbar-brand">
        <a href="/"><h1>Corthyn's Blog</h1></a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">☀️</button>
        <button class="navbar-burger" id="navbar-burger" aria-label="Menu">☰</button>
      </div>
      <div class="navbar-links" id="navbar-links">
        <a href="/about">About</a>
        <a href="/post">Blog</a>
        <a href="/categories">Categories</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div>
        &copy; {new Date().getFullYear()} <a href="/">Corthyn's Blog</a>
        &nbsp;|&nbsp; Powered by <a href="https://astro.build/" target="_blank">Astro</a>
      </div>
      <div class="footer-stats">
        <span id="waline-pageview-count">Loading</span> views &nbsp;|&nbsp;
        <span id="umami-site-pv">Loading</span> total &nbsp;|&nbsp;
        <span id="umami-site-uv">Loading</span> visitors
      </div>
    </footer>

    <script is:inline>
      function setTheme(theme) {
        if (theme === "dark") {
          document.body.classList.add("dark-mode");
          document.getElementById("theme-toggle").textContent = "🌙";
        } else {
          document.body.classList.remove("dark-mode");
          document.getElementById("theme-toggle").textContent = "☀️";
        }
        localStorage.setItem("theme", theme);
      }
      const saved = localStorage.getItem("theme");
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      setTheme(saved || (prefersDark ? "dark" : "light"));
      document.getElementById("theme-toggle").addEventListener("click", () => {
        const current = document.body.classList.contains("dark-mode") ? "dark" : "light";
        setTheme(current === "dark" ? "light" : "dark");
      });
      document.getElementById("navbar-burger").addEventListener("click", () => {
        document.getElementById("navbar-links").classList.toggle("active");
      });
    </script>

    <script is:inline>
      const WALINE_SERVER = 'https://waline-api-one.vercel.app';
      const currentPath = window.location.pathname;
      fetch(`${WALINE_SERVER}/api/article?path=${encodeURIComponent(currentPath)}`)
        .then(r => r.json())
        .then(d => {
          const el = document.getElementById('waline-pageview-count');
          if (el) el.textContent = d.data?.time || d.data || '?';
        })
        .catch(() => {
          const el = document.getElementById('waline-pageview-count');
          if (el) el.textContent = '?';
        });

      const UMAMI_API = 'https://analytics.umami.is/api/websites/YOUR_UMAMI_WEBSITE_ID/stats';
      fetch(UMAMI_API, { headers: { 'x-umami-token': '' } })
        .then(r => r.json())
        .then(d => {
          const pvEl = document.getElementById('umami-site-pv');
          const uvEl = document.getElementById('umami-site-uv');
          if (pvEl) pvEl.textContent = d.pageviews?.value ?? '?';
          if (uvEl) uvEl.textContent = d.visitors?.value ?? '?';
        })
        .catch(() => {
          const pvEl = document.getElementById('umami-site-pv');
          const uvEl = document.getElementById('umami-site-uv');
          if (pvEl) pvEl.textContent = '?';
          if (uvEl) uvEl.textContent = '?';
        });
    </script>
  </body>
</html>
